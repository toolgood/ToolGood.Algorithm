<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>PerfBench.Fast</AssemblyName>
    <RootNamespace>PerfBench</RootNamespace>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>

  <!-- 与 PerfBench 共用同一份基准代码，只替换底层库，保证用例完全一致 -->
  <ItemGroup>
    <Compile Include="..\PerfBench\Program.cs" Link="Program.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ToolGood.Algorithm.Fast\ToolGood.Algorithm.Fast.csproj" />
  </ItemGroup>

</Project>
