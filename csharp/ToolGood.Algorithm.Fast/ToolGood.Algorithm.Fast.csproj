<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<Description>ToolGood.Algorithm支持四则运算、Excel函数，并支持自定义参数。使用手写 Lexer + 递归下降 Parser，不依赖 Antlr4，解析速度更快</Description>
		<Copyright>Copyright 2017-2026 ToolGood</Copyright>
		<AssemblyTitle>ToolGood.Algorithm.Fast</AssemblyTitle>
		<Authors>ToolGood</Authors>
		<TargetFrameworks>netstandard2.1;net8.0;net9.0;net10.0</TargetFrameworks>
		<AssemblyName>ToolGood.Algorithm.Fast</AssemblyName>
		<PublicSign>true</PublicSign>
		<PackageId>ToolGood.Algorithm.Fast</PackageId>
		<PackageTags>algorithm;excel;excel-expressions;script;formula-grammar;formula;expression</PackageTags>
		<PackageProjectUrl>https://github.com/toolgood/ToolGood.Algorithm</PackageProjectUrl>
		<PackageLicenseUrl></PackageLicenseUrl>
		<RepositoryType>git</RepositoryType>
		<RootNamespace>ToolGood.Algorithm</RootNamespace>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
		<Product>ToolGood.Algorithm.Fast</Product>
		<PackageLicenseFile>LICENSE.md</PackageLicenseFile>
		<SignAssembly>true</SignAssembly>
		<Version>6.3.5</Version>
		<AssemblyOriginatorKeyFile>ToolGood.Algorithm.snk</AssemblyOriginatorKeyFile>
		<DelaySign>false</DelaySign>
		<DocumentationFile>bin\$(Configuration)\$(TargetFramework)\ToolGood.Algorithm.xml</DocumentationFile>
		<Nullable>disable</Nullable>
		<Configurations>Debug;Release</Configurations>
		<Title>ToolGood.Algorithm.Fast</Title>
		<PackageReadmeFile>README-EN.md</PackageReadmeFile>
		<RepositoryUrl></RepositoryUrl>
	</PropertyGroup>

	<ItemGroup>
		<None Include="..\..\LICENSE.md">
			<Pack>True</Pack>
			<PackagePath></PackagePath>
		</None>
		<None Include="..\..\README-EN.md">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>

	<!--
		复用 ToolGood.Algorithm 的全部运行时代码，但排除依赖 Antlr4 的部分：
		· math\*.cs           —— Antlr 生成的 Lexer / Parser / Visitor
		· Internals\Visitors  —— Antlr 版本的访问者、字符流、CharUtil
		· AlgorithmEngine.cs / AlgorithmEngineHelper.cs —— 内部换成手写解析入口

		对应的替代实现位于本项目的 math\Fast*.cs 与 AlgorithmEngine.Fast.cs / AlgorithmEngineHelper.Fast.cs。
	-->
	<ItemGroup>
		<Compile Include="..\ToolGood.Algorithm\**\*.cs" Exclude="..\ToolGood.Algorithm\obj\**\*.cs;..\ToolGood.Algorithm\math\mathLexer.cs;..\ToolGood.Algorithm\math\mathParser.cs;..\ToolGood.Algorithm\math\mathBaseVisitor.cs;..\ToolGood.Algorithm\math\mathVisitor.cs;..\ToolGood.Algorithm\math\Ext.cs;..\ToolGood.Algorithm\Internals\Visitors\CharUtil.cs;..\ToolGood.Algorithm\Internals\Visitors\AntlrCharStream.cs;..\ToolGood.Algorithm\Internals\Visitors\AntlrErrorData.cs;..\ToolGood.Algorithm\Internals\Visitors\DiyNameVisitor.cs;..\ToolGood.Algorithm\Internals\Visitors\MathFunctionVisitor.cs;..\ToolGood.Algorithm\Internals\Visitors\MathSplitVisitor.cs;..\ToolGood.Algorithm\Internals\Visitors\MathSplitVisitor2.cs;..\ToolGood.Algorithm\AlgorithmEngine.cs;..\ToolGood.Algorithm\AlgorithmEngineHelper.cs" />
	</ItemGroup>

</Project>
